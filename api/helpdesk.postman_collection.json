{
  "info": {
    "name": "Сервис обработки заявок",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Категории",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Создать заявку",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Не работает принтер\",\n  \"description\": \"Кабинет 104\",\n  \"categoryId\": 1,\n  \"priority\": \"HIGH\",\n  \"dueAt\": \"2030-01-20T16:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ticketId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Карточка",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Редактирование",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Проверить кабель\",\n  \"priority\": \"MEDIUM\",\n  \"dueAt\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 В работу",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Завершить",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RESOLVED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"closedTicket\", JSON.stringify(pm.response.json()));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 История до запрета",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/history"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"closedHistory\", JSON.stringify(pm.response.json()));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Запрет повторного открытия",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Запрет редактирования",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Запрещено\",\n  \"priority\": \"LOW\",\n  \"dueAt\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Карточка не изменилась",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Данные сохранены\", () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get(\"closedTicket\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 История не изменилась",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets/{{ticketId}}/history"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"История сохранена\", () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get(\"closedHistory\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Фильтры",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets?status=RESOLVED&priority=MEDIUM&categoryId=1&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Отчёт Kotlin",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reports/summary?from=2020-01-01T00:00:00Z&to=2100-01-01T00:00:00Z"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Неизвестная заявка",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tickets/9223372036854775807"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Валидация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \" \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Неверный период",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reports/summary?from=2030-01-01T00:00:00Z&to=2030-01-01T00:00:00Z"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
